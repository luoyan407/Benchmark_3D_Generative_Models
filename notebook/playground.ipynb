   "source": [
    "import torch\n",
    "import torch.nn as nn\n",
    "\n",
    "layer = nn.Linear(512,512)\n",
    "nn.init.kaiming_normal_(layer.weight, mode='fan_in', nonlinearity='relu')\n",
    "\n",
    "x = torch.rand(32,512)\n",
    "x = layer(x)\n",
    "x = nn.ReLU()(x)\n",
    "print(x)"
   ]
  }
